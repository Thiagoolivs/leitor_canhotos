# ==============================================================================
# DJANGO
# ==============================================================================
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=django-insecure-replace-this-with-a-strong-random-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ==============================================================================
# BANCO DE DADOS (PostgreSQL)
# ==============================================================================
DB_NAME=leitor_canhotos
DB_USER=leitor_canhotos
DB_PASSWORD=leitor2024
DB_HOST=db
DB_PORT=5432

# ==============================================================================
# REDIS / CELERY
# ==============================================================================
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ==============================================================================
# PASTAS DO SCANNER
# ==============================================================================
# Pasta onde o scanner salva as NOTAS FISCAIS escaneadas
SCANNER_NOTA_DIRS=/entrada_notas

# Pasta onde o scanner salva os CANHOTOS assinados
SCANNER_CANHOTO_DIRS=/entrada_canhotos

# Para multiplas pastas, separe por virgula:
# SCANNER_NOTA_DIRS=/entrada_notas,/entrada_notas_2
# SCANNER_CANHOTO_DIRS=/entrada_canhotos,/entrada_canhotos_2

# Pastas de saida (criadas automaticamente)
SCANNER_PROCESSED_DIR=/processados
SCANNER_ERROR_DIR=/erro

# ==============================================================================
# AUTO-VINCULAÇÃO
# ==============================================================================
# Quando True, canhotos com confiança ALTA/MEDIA são vinculados automaticamente.
# Canhotos com confiança BAIXA passam pelo fallback de IA antes de ir para revisão.
AUTO_VINCULAR_ALTA_CONFIANCA=True

# ==============================================================================
# IA FALLBACK (Groq / Llama)
# ==============================================================================
# Chave da API Groq — pegue grátis em https://console.groq.com
GROQ_API_KEY=gsk_SuaChaveAqui
# Modelo (padrão: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
# Desative com False se não quiser usar IA
AI_FALLBACK_HABILITADO=True

# ==============================================================================
# DIRETORIOS (internos ao container)
# ==============================================================================
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
LOGS_DIR=/app/logs
