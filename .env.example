# =============================================================================
# PASTAS DO SCANNER
# Caminhos no Windows host mapeados para dentro dos containers
# =============================================================================

# Pasta principal (obrigatoria)
SCANNER_HOST_DIR_1=M:\Nota_Fiscal\NF

# Pastas adicionais (opcionais - descomente e ajuste conforme necessario)
# SCANNER_HOST_DIR_2=M:\Nota_Fiscal\Filial2
# SCANNER_HOST_DIR_3=M:\Nota_Fiscal\SP

# Pastas internas dos containers (nao alterar sem ajustar docker-compose.yml)
# Para uma pasta: SCANNER_INPUT_DIRS=/entrada_canhotos
# Para multiplas: SCANNER_INPUT_DIRS=/entrada_canhotos,/entrada_canhotos_2,/entrada_canhotos_3
