# Redis / Celery
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --------------------------------------------------------
# PASTAS DO SCANNER
# --------------------------------------------------------
# Pasta onde o scanner salva as NOTAS FISCAIS escaneadas
# OCR extrai o numero e cria automaticamente o registro da nota com AGUARDANDO_CANHOTO
SCANNER_NOTA_DIRS=/entrada_notas

# Pasta onde o scanner salva os CANHOTOS assinados
# OCR extrai o numero, busca a nota e vincula o canhoto -> FINALIZADO
SCANNER_CANHOTO_DIRS=/entrada_canhotos

# Para multiplas pastas, separe por virgula:
# SCANNER_NOTA_DIRS=/entrada_notas,/entrada_notas_2
# SCANNER_CANHOTO_DIRS=/entrada_canhotos,/entrada_canhotos_2

SCANNER_PROCESSED_DIR=/processados
SCANNER_ERROR_DIR=/erro

# Django settings module
DJANGO_SETTINGS_MODULE=config.settings.development

# Media e Static (internos ao container)
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
LOGS_DIR=/app/logs
