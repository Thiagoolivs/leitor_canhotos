# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=troque-esta-chave-por-uma-segura-em-producao-32chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados PostgreSQL
DB_NAME=leitor_canhotos
DB_USER=leitor_canhotos
DB_PASSWORD=leitor2024
DB_HOST=localhost
DB_PORT=5432

# Redis (instalado localmente em C:\Redis)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --------------------------------------------------------
# PASTAS DO SCANNER
# --------------------------------------------------------
# Pasta onde o scanner salva as NOTAS FISCAIS escaneadas
# OCR extrai o numero e cria automaticamente o registro da nota com AGUARDANDO_CANHOTO
SCANNER_NOTA_DIRS=M:/Nota_Fiscal/NF

# Pasta onde o scanner salva os CANHOTOS assinados
# OCR extrai o numero, busca a nota e vincula o canhoto -> FINALIZADO
SCANNER_CANHOTO_DIRS=M:/Fatura/scaner_fat

# Para multiplas pastas, separe por virgula:
# SCANNER_NOTA_DIRS=M:/Nota_Fiscal/NF,M:/Nota_Fiscal/NF2
# SCANNER_CANHOTO_DIRS=M:/Fatura/scaner_fat,M:/Fatura/scaner_fat2

SCANNER_PROCESSED_DIR=C:/leitor_canhotos/processados
SCANNER_ERROR_DIR=C:/leitor_canhotos/erro

# Tesseract OCR - caminho do executavel no Windows
# Use barras normais (/) ou barras duplas (\\) - nunca barra simples (\)
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# Poppler (necessario para pdf2image)
# Use barras normais (/) no caminho
POPPLER_PATH=C:/poppler/bin

# Diretorios de media e logs (absolutos para Windows)
MEDIA_ROOT=C:/leitor_canhotos/media
LOG_DIR=C:/leitor_canhotos/logs
